# LedgerMind Backend Environment Configuration Example
# NEVER commit the real .env file. Keep this example file with empty placeholders only.

# Memory Configuration
# Options: "local" (default SQLite fallback) or "hindsight"
MEMORY_BACKEND=local
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Decision Agent LLM Configuration (Groq)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Application Settings
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./ledgermind.db
